<?xml version="1.0" encoding="utf-8"?>
<!-- Machines (Room) and preferences (DataStore) follow the user to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
