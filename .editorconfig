root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{html,css,js,json,yml,yaml}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Windows PowerShell 5.1 reads a script without a BOM in the legacy code page.
[*.ps1]
charset = utf-8-bom
